{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "artgallery/metadata",
  "title": "Artwork Metadata",
  "description": "List the date, size & materials for a given artwork.",
  "category": "artgallery",
  "textdomain": "artgallery",
  "attributes": {
    "width": {
      "type": "number",
      "default": 0
    },
    "height": {
      "type": "number",
      "default": 0
    },
    "depth": {
      "type": "number",
      "default": 0
    },
    "date": {
      "type": "string"
    }
  },
  "usesContext": [
    "postId",
    "postType",
    "queryId"
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}