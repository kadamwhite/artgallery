<?xml version="1.0"?>
<ruleset>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<!-- Use HM Coding Standards -->
	<rule ref="vendor/humanmade/coding-standards">
		<exclude name="HM.Files.FunctionFileName.WrongFile" />
		<!-- Docblock completeness is not enforced. -->
		<exclude name="Squiz.Commenting" />
	</rule>

	<!-- Blocks must be in a directory that matches the block slug, which sometimes includes dashes -->
	<rule ref="HM.Files.NamespaceDirectoryName.NameMismatch">
		<exclude-pattern>inc/blocks/*</exclude-pattern>
	</rule>

	<!-- Template output in markup.php echoes trusted, pre-built markup. -->
	<rule ref="HM.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>inc/markup.php</exclude-pattern>
	</rule>
</ruleset>
