{
	"name": "kadamwhite/artgallery",
	"description": "A WordPress plugin providing useful data structures & blocks for displaying artwork online",
	"type": "wordpress-plugin",
	"license": "(Artistic-2.0 OR GPL-2.0-or-later)",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"humanmade/coding-standards": "^2.5"
	},
	"scripts": {
		"phpcs": "phpcs --standard=phpcs.ruleset.xml -s ."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
